<h1>Taste City's Collection of Restaurants and Reviews</h1>
<link href="style.css" rel="stylesheet" type="text/css" />
<p>Below you will find a selection of restaurants reviewed by our users.</p>

{{!-- Create a table --}}
<table>
    
    {{!-- Header section --}}
    <thead>
        <tr>
            <th>Username</th>
            <th>Restaurant Name</th>
            <th>Location</th>
            <th>Cuisine Type</th>
            <th>Rating</th>
            <th>Review</th>
        </tr>
    </thead>

    {{!-- Body section --}}
    <tbody id="reviewsTableBody">
        {{#each data}}
        <tr>
            <td>{{this.username}}</td>
            <td>{{this.name}}</td>
            <td>{{this.location}}</td>
            <td>{{this.cuisine_type}}</td>
            <td>{{this.rating}}</td>
            <td>{{this.review}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>