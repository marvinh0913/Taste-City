<!DOCTYPE html>
<html>

<head>
    <title>Taste City</title>
    <link href="style.css" rel="stylesheet" type="text/css" />
</head>

<body>
    <nav>
    <ul>
        <li><a href="/index">Home</a></li>
        <li><a href="/users">Users</a></li>
        <li><a href="/my_collection">My Collection</a></li>
        <li><a href="/restaurants">Restaurants</a></li>
        <li><a href="/help">Helpful Information</a></li>
    </ul>
</nav>

    <div class="container">
        <h1 class="text-center">Taste City</h1>

        <p class="welcome-text">Welcome to Taste City! Please log in to view your collection of restaurants or navigate to the restaurant tab to see restaurants and their reviews.</p>

        {{#if error}}
        <p class="error">{{error}}</p>
        {{/if}}

        <!-- Login Form -->
        <div class="login-form">
            <h2>Login</h2>
            <form action="/login" method="POST">
                <label for="username">Username:</label>
                <input type="text" id="username" name="username" required>

                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required>

                <button type="submit" class="btn">Login</button>
            </form>

            <p class="new-user">New User? <a href="/users">Create an account</a></p>
        </div>
    </div>
</body>

</html>